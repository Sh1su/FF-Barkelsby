{
  "name": "fireedu",
  "private": true,
  "type": "module",
  "description": "Lehrgangsverwaltung Freiwillige Feuerwehr",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:gaps",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-cli.ts",
    "db:seed": "tsx scripts/seed-cli.ts",
    "check:gaps": "tsx scripts/check-coverage-gaps.ts",
    "test:a11y": "playwright test tests/a11y",
    "mail:test": "tsx --env-file=.env scripts/mail-test.ts",
    "user": "tsx --env-file-if-exists=.env scripts/user-cli.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.124",
    "@nuxt/ui": "^4.10.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.1",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  }
}
